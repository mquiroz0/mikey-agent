# Anthropic API key (server-side only — never use a REACT_APP_ prefix)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Allowed browser origin for CORS (Express defaults to http://localhost:3000)
# For Vercel cross-origin use, set this to your deployed frontend URL.
# Same-origin Vercel deploys do not need this.
ALLOWED_ORIGIN=http://localhost:3000
